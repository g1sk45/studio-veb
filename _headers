/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://api.web3forms.com; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com; frame-src https://apartmanibanvrbas.rs https://www.apartmanibanvrbas.rs; upgrade-insecure-requests

/privacy.html
  X-Robots-Tag: noindex, follow

/site-config.js
  Cache-Control: public, max-age=300

/*.html
  Cache-Control: public, max-age=3600

/*.css
  Cache-Control: public, max-age=604800, immutable

/*.js
  Cache-Control: public, max-age=604800, immutable

# OG slika mora biti javno učitljiva (Facebook, Viber, WhatsApp crawleri)
/assets/og-image.jpg
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=3600
  Content-Type: image/jpeg

/assets/og-image.png
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=3600
  Content-Type: image/png
